---
import { business } from '../data/site';
---
<div class="callbar" role="region" aria-label="Contact Raul">
  <a class="btn btn-gold" href={`tel:${business.phoneE164}`}>Call</a>
  <a class="btn btn-ghost" href={`sms:${business.phoneE164}`}>Text</a>
</div>

<style>
  .callbar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; background: var(--navy);
    display: grid; grid-template-columns: 1fr 1fr; gap: 10px;
    padding: 10px max(16px, env(safe-area-inset-right, 0px)) calc(10px + env(safe-area-inset-bottom, 0px)) max(16px, env(safe-area-inset-left, 0px));
    box-shadow: 0 -6px 20px rgba(0, 0, 0, .2);
  }
  .callbar .btn { padding: 12px; }
  @media (min-width: 800px) { .callbar { display: none; } }
</style>
