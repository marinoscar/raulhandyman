---
import Logo from './Logo.astro';
import { business } from '../data/site';
---
<header class="site-header band on-navy">
  <nav class="wrap nav" aria-label="Main">
    <a class="brand" href="/" aria-label={`${business.name} home`}>
      <Logo />
      <span class="brand-text"><b>Raul</b><span>HANDYMAN</span></span>
    </a>
    <div class="nav-links">
      <a href="/#services">Services</a>
      <a href="/#how-it-works">How it works</a>
      <a href="/#area">Service area</a>
      <a href="/#faq">FAQ</a>
    </div>
    <a class="btn btn-gold nav-call" href={`tel:${business.phoneE164}`}>Call<span class="num">&nbsp;{business.phoneDisplay}</span></a>
  </nav>
</header>

<style>
  .site-header { background: var(--navy); color: var(--on-navy); }
  .nav { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 16px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .brand-text b { display: block; font-family: var(--f-display); font-size: 1.5rem; font-weight: 800; line-height: 1; }
  .brand-text span { display: block; font-size: .66rem; letter-spacing: .32em; color: var(--gold-bright); font-weight: 700; margin-top: 3px; }
  .nav-links { display: none; gap: 24px; font-size: .95rem; color: var(--on-navy-muted); }
  .nav-links a { text-decoration: none; }
  .nav-links a:hover { color: var(--on-navy); }
  .nav-call { padding: 10px 16px; font-size: .95rem; }
  @media (min-width: 900px) { .nav-links { display: flex; } }
  .nav-call { gap: 0; }
  @media (max-width: 480px) { .nav-call .num { display: none; } }
</style>
