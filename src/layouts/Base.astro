---
import '@fontsource-variable/fraunces/wght.css';
import '@fontsource-variable/public-sans/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CallBar from '../components/CallBar.astro';
import { business } from '../data/site';
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import publicSansLatin from '@fontsource-variable/public-sans/files/public-sans-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  schema?: object[];
  noindex?: boolean;
  ogImage?: { src: string; width: number; height: number; alt: string };
  ogType?: 'website' | 'article';
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  /** LCP image to preload (set by pages that know their hero). */
  preloadImage?: { href: string; srcset?: string; sizes?: string; type?: string };
  /** rel=prev / rel=next hrefs for paginated lists. */
  prev?: string;
  next?: string;
}

const { title, description, schema = [], noindex = false, ogType = 'website', publishedTime, modifiedTime, preloadImage, prev, next } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = Astro.props.ogImage ?? { src: '/og.jpg', width: 1200, height: 630, alt: `${business.name}: handyman in ${business.baseCity}, ${business.region}` };
const ogImage = new URL(og.src, Astro.site).href;
const iso = (d?: Date | string) => (d ? new Date(d).toISOString() : undefined);
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#0e1f3d" />
    <meta name="format-detection" content="telephone=yes" />
    <meta name="geo.region" content="US-TX" />
    <meta name="geo.placename" content={business.baseCity} />

    <link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={publicSansLatin} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {prev && <link rel="prev" href={new URL(prev, Astro.site).href} />}
    {next && <link rel="next" href={new URL(next, Astro.site).href} />}
    {preloadImage && <link rel="preload" as="image" href={preloadImage.href} imagesrcset={preloadImage.srcset} imagesizes={preloadImage.sizes} type={preloadImage.type} fetchpriority="high" />}

    <meta property="og:type" content={ogType} />
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={iso(publishedTime)} />}
    {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={iso(modifiedTime)} />}
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(og.width)} />
    <meta property="og:image:height" content={String(og.height)} />
    <meta property="og:image:alt" content={og.alt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={og.alt} />

    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CallBar />
  </body>
</html>
