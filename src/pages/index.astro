---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { business, towns, homeFaq } from '../data/site';
import { businessSchema, websiteSchema } from '../data/schema';
import raul from '../assets/raul.jpg';

// Job photos: drop files into src/assets/work/ (e.g. "fence-repair-before.jpg").
// The section only renders when at least one photo exists.
const workFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/work/*.{jpg,jpeg,png,webp}', { eager: true });
const work = Object.entries(workFiles)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => {
    const file = path.split('/').pop() ?? '';
    const label = file.replace(/\.[^.]+$/, '').replace(/[-_]+/g, ' ');
    return { src: mod.default, alt: `${label.charAt(0).toUpperCase()}${label.slice(1)} by ${business.name}` };
  });

const photoForSchema = await getImage({ src: raul, width: 800, format: 'jpg' });
const photoUrl = new URL(photoForSchema.src, Astro.site).href;

const title = 'Handyman in Conroe & The Woodlands, TX | Raul Handyman';
const description = `Handyman in Conroe & The Woodlands, TX: drywall, painting, doors, fences, decks and repairs. ${business.yearsExperience} years, insured. Call or text ${business.phoneDisplay}.`;
const schema = [businessSchema(photoUrl), websiteSchema()];
---

<Base title={title} description={description} schema={schema}>
  <section class="hero band on-navy">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Handyman · Conroe &amp; The Woodlands, TX</span>
        <h1>Home repairs done right, <em>by someone who shows up.</em></h1>
        <p class="lede">
          Drywall, painting, doors, fences, decks and the small jobs that pile up. Over 20 years of experience,
          fully insured, and serving Conroe, The Woodlands and nearby areas.
        </p>
        <div class="cta-row">
          <a class="btn btn-gold" href={`tel:${business.phoneE164}`}>
            <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"></path></svg>
            Call Raul
          </a>
          <a class="btn btn-ghost" href={`sms:${business.phoneE164}`}>Text a photo of the job</a>
        </div>
        <p class="phone-line">Call or text <a class="num" href={`tel:${business.phoneE164}`}>{business.phoneDisplay}</a></p>
      </div>
      <figure class="photo">
        <Image
          src={raul}
          alt="Raul, owner of Raul Handyman"
          widths={[320, 420]}
          sizes="(min-width: 800px) 360px, 80vw"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption><b>Raul</b>Owner · does the work himself</figcaption>
      </figure>
    </div>
  </section>

  <div class="trust band on-navy">
    <ul class="wrap">
      <li><svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm1 10.4V6h-2v7.2l5 3 1-1.7z"></path></svg><span>{business.yearsExperience} years<small>of hands-on experience</small></span></li>
      <li><svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2 4 5v6c0 5 3.4 9.6 8 11 4.6-1.4 8-6 8-11V5zm-1.2 14-3.6-3.6 1.4-1.4 2.2 2.2 5-5 1.4 1.4z"></path></svg><span>Insured<small>proof available on request</small></span></li>
      <li><svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"></path></svg><span>Local<small>Conroe, The Woodlands &amp; nearby</small></span></li>
    </ul>
  </div>

  <section class="block band" id="services" aria-labelledby="services-h">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">Services</span>
        <h2 id="services-h">Handyman services in Conroe &amp; The Woodlands</h2>
        <p>One call covers most of the repair list around the house. Text a photo and Raul will tell you if it's a job he takes.</p>
      </div>
      <ServiceGrid />
      <p class="not-sure">Don't see your job? <a href={`sms:${business.phoneE164}`}>Text a photo</a> to {business.phoneDisplay}.</p>
    </div>
  </section>

  <section class="block band steps-band" id="how-it-works" aria-labelledby="how-h">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">How it works</span>
        <h2 id="how-h">From photo to fixed</h2>
      </div>
      <ol class="steps">
        <li><h3>Send a photo</h3><p>Text a picture of the problem and your neighborhood to {business.phoneDisplay}, or call.</p></li>
        <li><h3>Get a price</h3><p>Small jobs get a ballpark by text. Bigger jobs get a visit and a firm price before work starts.</p></li>
        <li><h3>Get it fixed</h3><p>Raul does the work himself and cleans up when he's done.</p></li>
      </ol>
    </div>
  </section>

  {work.length > 0 && (
    <section class="block band" id="work" aria-labelledby="work-h">
      <div class="wrap">
        <div class="head"><span class="eyebrow">Recent work</span><h2 id="work-h">Recent jobs</h2></div>
        <div class="gallery">
          {work.map((w) => <Image src={w.src} alt={w.alt} widths={[400, 700]} sizes="(min-width: 800px) 33vw, 50vw" />)}
        </div>
      </div>
    </section>
  )}

  {business.googleReviewUrl && (
    <section class="block band" id="reviews" aria-labelledby="reviews-h">
      <div class="wrap reviews">
        <span class="eyebrow">Reviews</span>
        <h2 id="reviews-h">Worked with Raul?</h2>
        <p>A Google review helps neighbors find a handyman they can trust.</p>
        <a class="btn btn-navy" href={business.googleReviewUrl} rel="noopener">Leave a Google review</a>
      </div>
    </section>
  )}

  <section class="area band" id="area" aria-labelledby="area-h">
    <div class="wrap area-grid">
      <div class="area-copy">
        <span class="eyebrow">Service area</span>
        <h2 id="area-h">Based in Conroe. Working across Montgomery County.</h2>
        <p>Most jobs are in Conroe and The Woodlands. Nearby towns are welcome too. If you're unsure, just ask.</p>
        <ul class="towns">
          {towns.map((t) => <li class={t.core ? 'core' : undefined}>{t.name}</li>)}
        </ul>
      </div>
      <svg class="map" viewBox="0 0 400 300" role="img" aria-label="Map sketch: Conroe north of The Woodlands along Interstate 45, with Willis, Montgomery, Magnolia and Spring nearby">
        <rect x="1" y="1" width="398" height="298" rx="10" fill="var(--bg)" stroke="var(--line)"></rect>
        <path d="M200 10 C 205 80, 195 150, 210 290" fill="none" stroke="var(--line)" stroke-width="10" stroke-linecap="round"></path>
        <text x="216" y="40" font-size="12" fill="var(--muted)">I-45</text>
        <circle cx="200" cy="140" r="95" fill="var(--gold)" opacity=".12"></circle>
        <circle cx="200" cy="140" r="95" fill="none" stroke="var(--gold)" stroke-dasharray="5 5"></circle>
        <circle cx="201" cy="100" r="9" fill="var(--gold)"></circle><text x="216" y="105" font-size="16" font-weight="700" fill="var(--ink)">Conroe</text>
        <circle cx="203" cy="190" r="9" fill="var(--gold)"></circle><text x="218" y="195" font-size="16" font-weight="700" fill="var(--ink)">The Woodlands</text>
        <circle cx="206" cy="60" r="5" fill="var(--muted)"></circle><text x="160" y="64" font-size="12" fill="var(--muted)">Willis</text>
        <circle cx="120" cy="105" r="5" fill="var(--muted)"></circle><text x="60" y="94" font-size="12" fill="var(--muted)">Montgomery</text>
        <circle cx="120" cy="190" r="5" fill="var(--muted)"></circle><text x="68" y="210" font-size="12" fill="var(--muted)">Magnolia</text>
        <circle cx="208" cy="255" r="5" fill="var(--muted)"></circle><text x="222" y="260" font-size="12" fill="var(--muted)">Spring</text>
        <text x="16" y="286" font-size="11" fill="var(--muted)">Not to scale</text>
      </svg>
    </div>
  </section>

  <section class="block band" id="faq" aria-labelledby="faq-h">
    <div class="wrap">
      <div class="head"><span class="eyebrow">Questions</span><h2 id="faq-h">Before you call</h2></div>
      <Faq items={homeFaq} />
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero { background: var(--navy); color: var(--on-navy); }
  .hero-grid { display: grid; gap: 32px; padding-block: 32px 0; align-items: end; }
  @media (min-width: 800px) { .hero-grid { grid-template-columns: 1.25fr .9fr; padding-top: 48px; } }
  .hero-copy { display: grid; gap: 20px; padding-bottom: 40px; min-width: 0; }
  h1 { font-size: clamp(2.3rem, 6.5vw, 4rem); font-weight: 800; letter-spacing: -.02em; }
  h1 em { font-style: normal; color: var(--gold-bright); }
  .lede { font-size: 1.15rem; color: var(--on-navy-muted); max-width: 34em; }
  .phone-line { color: var(--on-navy-muted); font-size: .95rem; }
  .phone-line .num { font-family: var(--f-display); font-size: 1.6rem; color: var(--on-navy); font-weight: 650; text-decoration: none; margin-left: 6px; font-variant-numeric: tabular-nums; }
  .photo { position: relative; justify-self: center; width: min(100%, 360px); margin: 0; }
  .photo::before { content: ''; position: absolute; inset: -10px 10px 0 -10px; border: 2px solid var(--gold); border-bottom: none; border-radius: 12px 12px 0 0; }
  .photo :global(img) { position: relative; display: block; width: 100%; height: auto; max-height: 440px; object-fit: cover; object-position: top; border-radius: 10px 10px 0 0; }
  .photo figcaption { position: absolute; left: -6px; bottom: 22px; background: var(--surface); color: var(--ink); padding: 10px 14px; border-radius: 6px; font-size: .85rem; box-shadow: 0 8px 24px rgba(0, 0, 0, .25); }
  .photo figcaption b { display: block; font-family: var(--f-display); font-size: 1.05rem; }

  .trust { background: var(--navy-2); color: var(--on-navy); }
  .trust ul { list-style: none; margin: 0 auto; padding-block: 18px; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px 28px; }
  .trust li { display: flex; gap: 12px; align-items: center; font-weight: 600; }
  .trust svg { flex: none; color: var(--gold-bright); }
  .trust small { display: block; font-weight: 400; color: var(--on-navy-muted); font-size: .85rem; }

  .not-sure { margin-top: 20px; color: var(--muted); }
  .not-sure a { color: var(--gold-text); font-weight: 700; }

  .steps-band { padding-top: 0; }
  .steps { list-style: none; counter-reset: step; margin: 0; padding: 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .steps li { counter-increment: step; display: grid; gap: 8px; align-content: start; padding-top: 18px; border-top: 3px solid var(--gold); }
  .steps li::before { content: 'Step ' counter(step); font-size: .78rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--gold-text); }
  .steps p { color: var(--muted); }

  .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; }
  .gallery :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 8px; }

  .reviews { display: grid; gap: 14px; justify-items: start; background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 32px; }
  .reviews p { color: var(--muted); }

  .area { background: var(--surface); border-block: 1px solid var(--line); }
  .area-grid { display: grid; gap: 32px; align-items: center; padding-block: 72px; }
  @media (min-width: 800px) { .area-grid { grid-template-columns: 1fr 1fr; } }
  .area-copy { display: grid; gap: 18px; min-width: 0; }
  .area-copy p { color: var(--muted); }
  .towns { display: flex; flex-wrap: wrap; gap: 10px; list-style: none; margin: 0; padding: 0; }
  .towns li { border: 1px solid var(--line); border-radius: 999px; padding: 8px 16px; font-weight: 600; background: var(--bg); }
  .towns li.core { border-color: var(--gold); background: var(--gold-soft); }
  .map { width: 100%; max-width: 100%; height: auto; display: block; font-family: var(--f-body); }
</style>
